+    def test_editorial_hierarchy_retains_activity_and_address_in_details(self):
+        trip, places = self.sample_data()
+        rendered = export_share.render_trip_html(trip, places)
+        self.assertIn('<p class="activity">Ramen lunch</p>', rendered)
+        self.assertIn('<p class="summary-address">東京都渋谷区</p>', rendered)
+        self.assertIn('data-support="true"', rendered)
+        self.assertNotIn('background-image:linear-gradient', rendered)
+
+    def test_visual_refresh_keeps_all_visits_and_curated_photos(self):
+        trip, places = export_share.load_trip(SCRIPT.parents[1], "japan-2027-feb")
+        rows = export_share.public_visits(trip, places)
+        rendered = export_share.render_trip_html(trip, places)
+        self.assertEqual(len(rows), 77)
+        self.assertEqual(rendered.count('<li id="stop-'), 77)
+        self.assertEqual(rendered.count('class="day" data-day='), 7)
+        for row in rows:
+            self.assertIn('datetime="' + row["visit"]["startTime"] + '"', rendered)
+        self.assertIn('min-height:44px', rendered)
+        self.assertIn('cue.dataset.live=String(live)', rendered)
+
